            </dynamic-attribute>
            <attribute>
                <attribute-path>product.custom.metal</attribute-path>
                <direction>descending</direction>
                <include-text-relevance>false</include-text-relevance>
            </attribute>
        </sorting-attributes>
    </sorting-rule>

