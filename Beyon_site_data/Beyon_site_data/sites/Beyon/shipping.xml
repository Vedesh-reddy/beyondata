<?xml version="1.0" encoding="UTF-8"?>
<shipping xmlns="http://www.demandware.com/xml/impex/shipping/2007-03-31">
    <shipping-method method-id="tanishq_shipment_de" default="false">
        <display-name xml:lang="x-default">Tanishq Shipment Germany</display-name>
        <online-flag>true</online-flag>
        <price-table>
            <amount order-value="0">50</amount>
        </price-table>
        <excluded-addresses>
            <included-addresses>
                <condition-group match-mode="all">
                    <condition>
                        <attribute-path>shipment.shippingAddress.countryCode</attribute-path>
                        <operator>is-not-equal</operator>
                        <string>DE</string>
                    </condition>
                </condition-group>
            </included-addresses>
        </excluded-addresses>
        <custom-attributes>
            <custom-attribute attribute-id="storePickupEnabled">false</custom-attribute>
        </custom-attributes>
        <currency>USD</currency>
    </shipping-method>

