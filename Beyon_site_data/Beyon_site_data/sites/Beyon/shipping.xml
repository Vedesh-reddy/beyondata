    <shipping-method method-id="tanishq_shipment_us" default="false">
        <display-name xml:lang="x-default">Tanishq Shipment United States</display-name>
        <online-flag>true</online-flag>
        <price-table>
            <amount order-value="0">50</amount>
        </price-table>
        <excluded-products>
            <included-products>
                <condition-group>
                    <attribute-condition operator="exists" attribute-id="pricingGroupType"/>
                    <attribute-condition operator="equals" attribute-id="pricingGroupType">
                        <attribute-value>GOLDPLAIN</attribute-value>
                    </attribute-condition>
                </condition-group>
                <condition-group>
                    <attribute-condition operator="contains" attribute-id="CFAProductCode">
                        <attribute-value>LB</attribute-value>
                    </attribute-condition>
                </condition-group>
            </included-products>
        </excluded-products>
        <excluded-addresses>
            <included-addresses>
                <condition-group match-mode="all">
                    <condition>
                        <attribute-path>shipment.shippingAddress.countryCode</attribute-path>
                        <operator>exists</operator>
                    </condition>
                </condition-group>
            </included-addresses>
            <excluded-addresses>
                <condition-group match-mode="all">
                    <condition>
                        <attribute-path>shipment.shippingAddress.countryCode</attribute-path>
                        <operator>is-equal</operator>
                        <string>US</string>
                    </condition>
                </condition-group>
            </excluded-addresses>
        </excluded-addresses>
        <custom-attributes>
            <custom-attribute attribute-id="storePickupEnabled">false</custom-attribute>
        </custom-attributes>
        <currency>USD</currency>
    </shipping-method>

