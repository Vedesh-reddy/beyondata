<?xml version="1.0" encoding="UTF-8"?>
<payment-settings xmlns="http://www.demandware.com/xml/impex/paymentsettings/2009-09-15">
    <payment-method method-id="NEU_LOYALTY">
        <name xml:lang="x-default">NEU LOYALTY</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>NEU_LOYALTY</processor-id>
    </payment-method>

    <payment-method method-id="ENCIRCLE_LOYALTY">
        <name xml:lang="x-default">ENCIRCLE LOYALTY</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>ENCIRCLE_LOYALTY</processor-id>
    </payment-method>

    <payment-method method-id="GIFT_CERTIFICATE">
        <name xml:lang="x-default">Gift Certificate</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>BASIC_GIFT_CERTIFICATE</processor-id>
    </payment-method>

    <payment-method method-id="CREDIT_CARD">
        <name xml:lang="x-default">Credit Card</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>BASIC_CREDIT</processor-id>
    </payment-method>

    <payment-method method-id="eVoucher">
        <enabled-flag>true</enabled-flag>
        <processor-id>Qwikcilver_CREDIT</processor-id>
    </payment-method>

    <payment-method method-id="GCTanishq">
        <enabled-flag>true</enabled-flag>
        <processor-id>Qwikcilver_CREDIT</processor-id>
    </payment-method>

    <payment-method method-id="eGCTanishq">
        <enabled-flag>true</enabled-flag>
        <processor-id>Qwikcilver_CREDIT</processor-id>
    </payment-method>

    <payment-method method-id="BANK_TRANSFER">
        <name xml:lang="x-default">Bank Transfer</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>RAZORPAY</processor-id>
    </payment-method>

    <payment-method method-id="PAYTM">
        <enabled-flag>false</enabled-flag>
        <processor-id>PAYTM</processor-id>
    </payment-method>

    <payment-method method-id="RAZORPAY">
        <enabled-flag>true</enabled-flag>
        <processor-id>RAZORPAY</processor-id>
    </payment-method>

    <payment-method method-id="PayPal">
        <name xml:lang="x-default">PayPal</name>
        <enabled-flag>true</enabled-flag>
        <processor-id>PAYPAL</processor-id>
    </payment-method>

    <payment-method method-id="BML">
        <name xml:lang="x-default">Bill Me Later</name>
        <enabled-flag>false</enabled-flag>
        <processor-id>CYBERSOURCE_BML</processor-id>
    </payment-method>

    <payment-method method-id="DW_APPLE_PAY">
        <name xml:lang="x-default">Apple Pay</name>
        <enabled-flag>false</enabled-flag>
    </payment-method>

    <payment-method method-id="DW_ANDROID_PAY">
        <name xml:lang="x-default">Android Pay</name>
        <enabled-flag>false</enabled-flag>
    </payment-method>

    <payment-method method-id="GHS_Discount_Voucher">
        <name xml:lang="x-default">GHS Discount Voucher</name>
        <description xml:lang="x-default">GHS Discount Voucher</description>
        <enabled-flag>true</enabled-flag>
        <processor-id>GHS_Discount_Voucher</processor-id>
    </payment-method>

    <payment-method method-id="DIGIGOLD">
        <name xml:lang="x-default">DigiGold Redemption</name>
        <description xml:lang="x-default">For Digigold Checkout redemption</description>
        <enabled-flag>false</enabled-flag>
        <processor-id>DIGIGOLD_REDEEMPTION</processor-id>
        <currencies>
            <currency>INR</currency>
            <currency>USD</currency>
        </currencies>
    </payment-method>

    <payment-method method-id="COD">
        <enabled-flag>true</enabled-flag>
        <processor-id>COD</processor-id>
    </payment-method>

    <payment-method method-id="JUSPAY">
        <description xml:lang="x-default">JusPay</description>
        <enabled-flag>true</enabled-flag>
        <processor-id>JUSPAY</processor-id>
    </payment-method>

    <payment-card card-type="Visa">
        <name xml:lang="x-default">Visa</name>
        <enabled-flag>false</enabled-flag>
        <card-number-settings>
            <enable-checksum-verification>true</enable-checksum-verification>
            <number-length>
                <length>13</length>
                <length>16</length>
            </number-length>
            <number-prefix>
                <prefix>4</prefix>
            </number-prefix>
        </card-number-settings>
        <security-code-length>3</security-code-length>
    </payment-card>

    <payment-card card-type="Amex">
        <name xml:lang="x-default">American Express</name>
        <enabled-flag>false</enabled-flag>
        <card-number-settings>
            <enable-checksum-verification>true</enable-checksum-verification>
            <number-length>
                <length>15</length>
            </number-length>
            <number-prefix>
                <prefix>34</prefix>
                <prefix>37</prefix>
            </number-prefix>
        </card-number-settings>
        <security-code-length>4</security-code-length>
    </payment-card>

    <payment-card card-type="Master">
        <name xml:lang="x-default">Master Card</name>
        <enabled-flag>false</enabled-flag>
        <card-number-settings>
            <enable-checksum-verification>true</enable-checksum-verification>
            <number-length>
                <length>16</length>
            </number-length>
            <number-prefix>
                <prefix>2221-2720</prefix>
                <prefix>51-55</prefix>
            </number-prefix>
        </card-number-settings>
        <security-code-length>3</security-code-length>
    </payment-card>

    <payment-card card-type="Discover">
        <name xml:lang="x-default">Discover</name>
        <enabled-flag>false</enabled-flag>
        <card-number-settings>
            <enable-checksum-verification>true</enable-checksum-verification>
            <number-length>
                <length>16</length>
            </number-length>
            <number-prefix>
                <prefix>6011</prefix>
                <prefix>622126-622925</prefix>
                <prefix>644-649</prefix>
                <prefix>65</prefix>
            </number-prefix>
        </card-number-settings>
        <security-code-length>3</security-code-length>
        <countries>
            <country country-code="US"/>
        </countries>
    </payment-card>

</payment-settings>
